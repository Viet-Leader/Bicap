# =========================================================
# BICAP - .gitignore
# =========================================================


# =========================================================
# IDE / Editor
# =========================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.sts4-cache/


# =========================================================
# Java / Spring Boot / Maven
# =========================================================

# Maven build output
backend/target/

# Gradle build output
backend/build/

# Java compiled files
*.class
*.hprof

# Logs
*.log
backend/logs/


# =========================================================
# Node.js / Vue / Frontend
# =========================================================

# Dependencies
frontend/node_modules/

# Vite / Vue build output
frontend/dist/

# Frontend coverage
frontend/coverage/

# Frontend temporary/generated files
frontend/.vite/

# npm logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*


# =========================================================
# Blockchain / Hardhat
# =========================================================

# Dependencies
blockchain/node_modules/

# Hardhat generated files
blockchain/artifacts/
blockchain/cache/

# Hardhat coverage
blockchain/coverage/

# Build output
blockchain/dist/

# Hardhat Ignition generated deployment data
blockchain/ignition/deployments/

# npm logs
blockchain/npm-debug.log*
blockchain/yarn-debug.log*
blockchain/yarn-error.log*
blockchain/pnpm-debug.log*


# =========================================================
# Docker / PostgreSQL
# =========================================================

# PostgreSQL persistent data
postgres-data/

# Docker local data
docker-data/


# =========================================================
# Database Backup
# =========================================================

# PostgreSQL custom-format backup
*.backup

# PostgreSQL dump
*.dump


# =========================================================
# Upload / Generated Files
# =========================================================

# Temporary / generated files
tmp/
temp/
output/


# =========================================================
# Operating System
# =========================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store


# =========================================================
# Temporary / Backup Files
# =========================================================

*.tmp
*.temp
*.bak
*.swp
*.swo


# =========================================================
# Environment
# =========================================================

.env
.env.*
!.env.example