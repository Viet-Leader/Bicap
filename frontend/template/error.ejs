<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Error</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f8d7da; color: #721c24; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .error-box { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center; }
        h1 { color: #c9302c; }
        a { color: #4e73df; text-decoration: none; margin-top: 20px; display: inline-block; }
    </style>
</head>
<body>
    <div class="error-box">
        <h1>Error</h1>
        <p><%= message || 'Đã xảy ra lỗi. Vui lòng thử lại.' %></p>
        <a href="/">Quay về trang chủ</a>
    </div>
    <script>
        // --- LOGIC INJECTION: Error Handling ---
        function goBack() {
            if (window.history.length > 1) {
                window.history.back();
            } else {
                window.location.href = '/';
            }
        }

        function retryAction() {
            // Thực hiện tải lại trang hoặc có thể gửi lại request
            window.location.reload();
        }

        // Error logging
        window.addEventListener('load', () => {
            const errorMessage = "<%= message || 'Unknown error' %>";
            console.error('Error logged on client:', errorMessage);
            // Gửi log đến server nếu cần
            fetch('/api/v1/logs/error', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ error: errorMessage, url: window.location.href })
            }).catch(e => console.error('Failed to log error to server', e));
        });
    </script>
</body>
</html>
